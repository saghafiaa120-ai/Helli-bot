# توکن ربات از BotFather
BOT_TOKEN=
# شناسه عددی مالک(های) ربات، جدا شده با کاما (اختیاری)
OWNER_IDS=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# پروکسی اتصال به تلگرام، مثلاً http://127.0.0.1:8080 (اختیاری)
TELEGRAM_PROXY=

# --- دیتابیس (MySQL/MariaDB روی XAMPP) ---
# نام دیتابیس را در phpMyAdmin بسازید (پیش‌فرض: helli) با collation = utf8mb4_unicode_ci.
# کاربر پیش‌فرض XAMPP: root با رمز خالی. اگر برای root رمز گذاشته‌اید، همان را این‌جا بگذارید.
# اگر رمز کاراکتر خاص دارد، باید URL-encode شود (مثلاً @ → %40).
DATABASE_URL=mysql+asyncmy://root:@127.0.0.1:3306/helli?charset=utf8mb4